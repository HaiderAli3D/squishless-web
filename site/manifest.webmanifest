{
  "id": "/app",
  "name": "Squishless",
  "short_name": "Squishless",
  "description": "Resize photos without the squish. Content-aware resizing that runs entirely in your browser.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fdf6f4",
